# Paired and trusted Siri Remote.
SIRI_REMOTE_MAC=70:48:0F:F2:65:99
SIRI_ADDR_TYPE=public
# medium requests an authenticated/encrypted link using the existing bond.
SIRI_SECURITY=medium
SIRI_ATT_MTU=23
SIRI_KEEPALIVE_SECONDS=0
# Read once after connecting and every 15 minutes normally. At 5-9%, reread
# every five minutes and show a white warning for one second. At 0-4%, reread
# every minute and flash the white warning three times.
SIRI_BATTERY_CHECK_SECONDS=900
SIRI_BATTERY_LOW_CHECK_SECONDS=300
SIRI_BATTERY_CRITICAL_CHECK_SECONDS=60
SIRI_BATTERY_LOW_PERCENT=10
SIRI_BATTERY_CRITICAL_PERCENT=5
SIRI_RECLAIM_BUSY=yes
SIRI_DEBUG=no

MOODE_URL=http://localhost/command/
MOODE_HTTP_TIMEOUT=4
MOODE_PLAY_PAUSE_CMD=toggle_play_pause
MOODE_VOLUME_UP_CMD=set_volume -up 5
MOODE_VOLUME_DOWN_CMD=set_volume -dn 5
MOODE_PREVIOUS_CMD=previous
MOODE_NEXT_CMD=next

# Ignore ordinary remote commands while an external moOde renderer is active
# (AirPlay, Spotify Connect, Bluetooth, etc.). Battery display and Home-button
# shutdown remain available. The short cache also covers rapid volume presses.
SIRI_IGNORE_DURING_RENDERER=yes
SIRI_RENDERER_CACHE_SECONDS=0.25

# Gen-1 touchpad X range is approximately 2278..3914. A physical click left
# or right of the split invokes Previous or Next. The center dead-zone avoids
# ambiguous clicks; ordinary touches and swipes perform no action.
SIRI_TOUCH_X_SPLIT=3096
SIRI_TOUCH_DEAD_ZONE=60
SIRI_TOUCH_MAX_AGE_SECONDS=1.5

# The tested first-generation TV/Home button reports bit 0x01. Holding it for
# three uninterrupted seconds powers off the Pi; releasing early cancels it.
SIRI_HOME_BUTTON_MASK=0x01
SIRI_HOME_HOLD_SECONDS=3
SIRI_HOME_COMMAND=/usr/bin/systemctl poweroff
# Optional buttons that are not used by the stable default mapping.
MOODE_MENU_CMD=
MOODE_AIRPLAY_CMD=

# Short Menu/Back press: click moOde's cover-art link to open the last Library
# view. This works identically for radio and local audio files. A second press
# returns through the existing bottom playbar. No extra package is required.
SIRI_MENU_SCREEN_CLICK=yes
SIRI_X_DISPLAY=:0
SIRI_XAUTHORITY=/home/pi/.Xauthority

# Non-blocking one-second on-screen feedback. New button events immediately
# replace an older overlay; rapid volume clicks never build up a display queue.
SIRI_OVERLAY=yes
SIRI_OVERLAY_SECONDS=1

RECONNECT_MIN=0.2
RECONNECT_MAX=1
