[Unit]
Description=Siri Remote control for moOde Audio
Documentation=https://github.com/Yanndroid/SiriRemote-Linux
Wants=bluetooth.target
After=bluetooth.target network.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/siri-remote-moode
ExecStart=/usr/bin/python3 -u /usr/local/sbin/siri_remote_moode.py
Restart=on-failure
RestartSec=2s
User=root
Group=root
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_BLUETOOTH AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
